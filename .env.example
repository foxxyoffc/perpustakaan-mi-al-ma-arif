# =========================================================
# MI AL-MA'ARIF NUSANTARA
# LIBRARY - ENVIRONMENT VARIABLES
# =========================================================

# =========================================================
# SUPABASE
# =========================================================

# URL project Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable/anon key
# Aman digunakan di browser jika RLS database sudah benar.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# =========================================================
# SUPABASE SERVER
# =========================================================

# SERVICE ROLE KEY
# PENTING:
# - JANGAN diberi prefix NEXT_PUBLIC_
# - JANGAN dimasukkan ke kode client
# - JANGAN diupload ke GitHub
# - Hanya digunakan oleh server/API
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =========================================================
# SITE
# =========================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =========================================================
# APPLICATION
# =========================================================

NEXT_PUBLIC_APP_NAME=MI Al-Ma'arif Nusantara
NEXT_PUBLIC_APP_DESCRIPTION=Perpustakaan Digital MI Al-Ma'arif Nusantara

# =========================================================
# SECURITY
# =========================================================

# Secret untuk kebutuhan server-side aplikasi.
# Gunakan string random yang panjang.
APP_SECRET=change-this-to-a-long-random-secret

# =========================================================
# CONTACT
# =========================================================

# Nomor kontak hanya sebagai fallback.
# Kontak utama nantinya dapat diatur melalui database
# oleh Developer.
NEXT_PUBLIC_CONTACT_WHATSAPP_1=
NEXT_PUBLIC_CONTACT_WHATSAPP_2=
NEXT_PUBLIC_CONTACT_EMAIL=
